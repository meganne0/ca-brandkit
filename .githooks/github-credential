#!/usr/bin/env bash
# Credential helper: refuse GitHub HTTPS auth unless meganne0 is active.
# Blocks push, pull, and fetch for this repo when the other account is active.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
# shellcheck source=/dev/null
source "$ROOT/.githooks/require-meganne0.sh"
exec gh auth git-credential "$@"
